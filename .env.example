# Local development only; never reuse these example credentials in production.
QUAL_HTTP_ADDR=127.0.0.1:18080
QUAL_API_PROXY_TARGET=http://127.0.0.1:18080
# Must match the full browser Origin exactly, including hostname and port.
# Only loopback origins are allowed in the Phase 3 local-session implementation.
QUAL_WEB_ORIGIN=http://127.0.0.1:5173

QUAL_DB_PORT=15432
QUAL_DB_PASSWORD=qual_dev_only
DATABASE_URL=postgres://qual:qual_dev_only@127.0.0.1:15432/qual?sslmode=disable

QUAL_S3_PORT=18333
QUAL_S3_ACCESS_KEY=qualdev
QUAL_S3_SECRET_KEY=qual_dev_only
QUAL_S3_ENDPOINT=http://127.0.0.1:18333
QUAL_S3_BUCKET=qual-artifacts
# Phase 5: webhook subscriptions are disabled until a per-deployment random
# AES-256-GCM master key and explicit HTTPS hostname allowlist are configured.
# Generate a secret locally with: openssl rand -hex 32
# Do not store a real key in this file or commit it to Git.
# QUAL_WEBHOOK_ENCRYPTION_KEY=<64 hexadecimal characters>
# QUAL_WEBHOOK_ALLOWED_HOSTS=hooks.example.com

# Phase 6: readiness /readyz checks schema version 10 + configured S3.
# /internal/metrics remains absent unless a SEPARATE operator-only random
# Bearer secret at least 32 characters is injected into the Go service.
# QUAL_METRICS_TOKEN=<separate randomly generated secret>
# qual-ops private PG/S3 signed backup & restore drill require a stable,
# independently safeguarded 32-byte (64-hex) HMAC key. Do not commit real keys.
# QUAL_BACKUP_HMAC_KEY=<64 hex chars>
# Operate backups only during a write-free maintenance window.
